{
  "include": ["client/src/**/*"],
  "exclude": ["node_modules", "dist", "dist-ssr"],
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "target": "ES2022",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "types": ["node", "vite/client"],
    "paths": { "@/*": ["./client/src/*"] }
  }
}
